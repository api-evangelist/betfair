          "id": "21aed43d-f88f-4ce4-9826-3ecd1466d765",
          "name": "Heartbeat (dead man's switch)",
          "request": {
            "name": "Heartbeat (dead man's switch)",
            "description": {
              "content": "Registers a heartbeat with a preferred timeout (seconds). If Betfair does not receive a subsequent heartbeat within the timeout it will cancel the customer's unmatched bets. Preferred timeout is clamped between 10 and 300 seconds; a value of 0 disables the switch.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "heartbeat",
                "rest",
                "v1.0",
                "heartbeat",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
